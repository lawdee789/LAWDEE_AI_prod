# Flask server configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=8000

# Semantic ranking
SENTENCE_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
LAWYER_DATA_PATH=data/lawyers.sample.json
DEFAULT_TOP_K=5

# Cross-origin requests (comma separated list)
CORS_ORIGINS=http://localhost:5050,http://localhost:3000

# Express backend -> Flask URL
FLASK_URL=http://localhost:8000
